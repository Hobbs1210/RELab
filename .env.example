# Set to the IP assigned to your isolated lab Docker host.
LAB_IP=127.0.0.1
TARGET_IP=192.0.2.10
CAPTURE_INTERFACE=any
DNS_BIND_IP=127.0.0.1
HTTPS_BIND_IP=127.0.0.1
LAB_BIND_IP=0.0.0.0
API_BIND_IP=0.0.0.0
# setup.sh generates a unique password when absent; keep it private.
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=
# Full AdGuard MCP for DNS experiments; change to read-only to prevent edits.
ADGUARD_ACCESS_TIER=full
# BLE MCP is listening and read-capable; explicit opt-in for GATT writes.
BLE_MCP_ALLOW_WRITES=false
BLE_MCP_WRITE_ALLOWLIST=
BLE_MCP_PLUGINS=
BLE_MCP_AUTH_TOKEN=

# Generated on first run and required for all write actions (X-Lab-Token).
RESEARCH_DB_PASSWORD=
LAB_ADMIN_TOKEN=
# Offline packet analysis safety limit.
MAX_PCAP_BYTES=209715200
# Optional official binary URL; omit to fetch latest Ghidra at image build time.
GHIDRA_RELEASE_URL=

# Selected device profile. generic rewrites nothing; options are listed in profiles/.
TARGET_PROFILE=generic

# Bounded local-emulator-only boofuzz campaign (1..1000).
FUZZ_MAX_CASES=100

# Explicitly configure only an attached, owned serial test device for physical fuzzing.
# SERIAL_FUZZ_DEVICE=/dev/ttyUSB0
SERIAL_FUZZ_ACK=DISABLED

# setup.sh sets these to your host user IDs for writable bind-mount artifacts.
LAB_UID=1000
LAB_GID=1000
