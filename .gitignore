# Local secrets and runtime artifacts; never commit captures or private firmware.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
certs/*
!certs/.gitkeep
data/*
!data/**/
!data/**/.gitkeep
firmware/*
!firmware/.gitkeep
research/*
!research/.gitkeep
config/adguard/conf/
config/adguard/work/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/__pycache__/
*.py[cod]
*.pcap
*.pcapng
*.mitm
*.db
*.sqlite
*.sqlite3
*.log
*.part
.DS_Store
dist/
*.zip

# Frontend & Node modules
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
